*.py text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
# Frozen protocol hashes refer to exact bytes, including historical newlines.
protocol_frozen.json -text whitespace=cr-at-eol
protocols/*.json -text whitespace=cr-at-eol
# Published evidence is hashed byte-for-byte; disable checkout normalization.
runs/** -text whitespace=cr-at-eol
report/** -text whitespace=cr-at-eol
validation/*.json -text whitespace=cr-at-eol
*.pdf binary
# Matplotlib emits spaces in multiline SVG path data.
*.svg -whitespace
